path-constant src-dir : . ;
path-constant src-hpp-dir : ./hpp ;

project
	dotit-sources
:
	requirements
		<include>$(src-hpp-dir)
:
	default-build
		<cxxstd>26
;

build-project cpp ;
build-project tests ;

alias install : ./cpp//install ./hpp//install ;
explicit install ;

