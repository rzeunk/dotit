path-constant prj-dir : . ;

if [ MATCH ^(cleanall)$ : [ modules.peek : ARGV ] ]
{
	echo "cleanall ..." ;

	cmd = "rm -rf `find $(prj-dir) -name bin`" ;
	echo $(cmd) ;
	SHELL $(cmd) ;
	exit ;
}

project
	dotit
;

constant version-major : 99 ;
constant version-minor : 999 ;
constant version-patch : 9999 ;

constant
	version
:
	$(version-major).$(version-minor).$(version-patch)
;

build-project sources ;

rule get-prefix ( )
{
	local prefix = [ option.get prefix ] ;
	if $(prefix)
	{
		return $(prefix) ;
	}
	else
	{
		return /usr/local ;
	}
}

constant prefix : [ get-prefix ] ;

alias
	install
:
	./sources//install
;
explicit install ;

